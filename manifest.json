{
  "manifest_version": 3,
  "name": "Mode sombre intelligent",
  "version": "1.0.0",
  "description": "Assombrit les pages claires, laisse intactes les pages déjà sombres et les blocs déjà sombres.",
  "action": {
    "default_title": "Mode sombre intelligent",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Activer / désactiver le mode sombre sur ce site"
    }
  }
}
